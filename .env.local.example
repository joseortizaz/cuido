# Copiar a .env.local (no versionado) y rellenar con los valores del proyecto
# Supabase pieueeejyehuufbdxdeb. Nunca commitear .env.local ni pegar estos
# valores directamente en el código.

# Panel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://pieueeejyehuufbdxdeb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen público de este entorno (usado para el link de confirmación de
# correo al registrarse). En Vercel, setear al dominio real de cada
# entorno (preview/producción); en dev cae a http://localhost:3000 si se omite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para scripts de servidor de confianza (p.ej. test de aislamiento de
# tenants). BYPASSA RLS. Nunca exponer con prefijo NEXT_PUBLIC_, nunca usar
# en código de cliente ni commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta Graph API) -- src/lib/whatsapp/env.ts.
#
# WHATSAPP_MODE decide qué par de variables se usa: "test" (default si se
# omite) lee las variables con sufijo _TEST; "production" lee las
# variables sin sufijo. Así pueden coexistir ambos conjuntos de
# credenciales sin pisarse durante la transición de la cuenta de prueba
# a la cuenta real.
WHATSAPP_MODE=test

# Credenciales de la cuenta y App DE PRUEBA de Meta -- App "Cuido - Test1"
# (App ID 1346275041895125), cuenta "Test WhatsApp Business Account"
# (+1 555-669-0076). Panel: Meta for Developers > Cuido - Test1 >
# WhatsApp > API Setup.
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_ACCESS_TOKEN=

# Credenciales de la cuenta REAL (pendiente -- Meta sigue revisando un
# permiso de plantillas). App "Cuido" principal (App ID 1088516603521677),
# conectada a la cuenta real de WhatsApp Business de Narnia Tech
# Solution. NO rellenar hasta que esa App esté lista para producción.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Opcional -- versión de la Graph API de Meta. Cae a v21.0 si se omite.
WHATSAPP_API_VERSION=
